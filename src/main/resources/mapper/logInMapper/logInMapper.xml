<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bmm.api.logIn.LogInMapper">

    <select id="getOngoingUser" parameterType="string" resultType="com.bmm.api.logIn.UserDTO">
    
   <!--  SQL ID : LogInMapper.getOngoingUser -->
        SELECT 
			USER_ID,
			USER_PASSWORD				
		FROM TB_USER
		WHERE USER_ID = #{userId}
    </select>
    
    <select id="getListUserRole" parameterType="string" resultType="com.bmm.api.logIn.UserRoleDTO">
	
<!--		SQL ID : LogInMapper.getListUserRole -->  <!--사용자 권한 리스트 가져오기-->
		
		SELECT
			tur.USER_ID,
			tr.ROLE_CODE,
			tr.ROLE_GROUP,
			tr.ROLE_NM,
			tr.ORDERS
		FROM tb_ROLE tr
		JOIN tb_USER_ROLE tur ON tur.ROLE_CODE = tr.ROLE_CODE
		WHERE USER_ID =  #{userid}
		
	
	</select>



</mapper>