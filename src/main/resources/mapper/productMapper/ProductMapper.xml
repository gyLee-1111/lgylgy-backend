	<select id="getListProductNaver" parameterType="int" resultType="com.bmm.api.product.ProductDTO">
    
   <!--  SQL ID : ProductMapper.getListProductNaver -->
		SELECT 
			tp.KEYWORD_CODE,
			tp.PRODUCT_CODE,
			tp.PRODUCT_NM,
			tp.SALES,
			tp.AMOUNT,
			tp.PLATFORM,
			tp.PRODUCT_IMG,
			tp.REGISTRATION_DT,
			tp.DELIVERY_DATE,
			(SELECT COUNT(*) FROM TB_REVIEW tr WHERE tp.PRODUCT_CODE = tr.PRODUCT_CODE) AS REVIEW_CNT,
			(SELECT AVG(REVIEW_SCORE)
			FROM TB_REVIEW WHERE PRODUCT_CODE = tp.PRODUCT_CODE) as AVG_SCORE
		FROM TB_PRODUCT tp
		WHERE KEYWORD_CODE = #{keywordCode}
		AND tp.PLATFORM = 'PLATFORM_01'
    </select>
    <select id="getTotalPriceNaver" parameterType="int" resultType="com.bmm.api.product.ProductResponseDTO">
    
   <!--  SQL ID : ProductMapper.getTotalPriceNaver -->
		SELECT 
		    SUM(tp.SALES * tp.AMOUNT) AS TOTAL_PRICE
		FROM TB_PRODUCT tp
		WHERE tp.KEYWORD_CODE = #{keywordCode}
		AND tp.PLATFORM = 'PLATFORM_01'
    </select>
    <select id="getListProductCoupang" parameterType="int" resultType="com.bmm.api.product.ProductDTO">
    
   	<!--  SQL ID : ProductMapper.getListProductCoupang -->
		SELECT 
			tp.KEYWORD_CODE,
			tp.PRODUCT_CODE,
			tp.PRODUCT_NM,
			tp.SALES,
			tp.AMOUNT,
			tp.PLATFORM,
			tp.PRODUCT_IMG,
			tp.REGISTRATION_DT,
			tp.DELIVERY_DATE,
			COALESCE(COUNT(tr.REVIEW_CODE)) AS REVIEW_CNT,
			ROUND(AVG(tr.REVIEW_SCORE), 2) AS AVG_SCORE,
			(tp.SALES * tp.AMOUNT) AS TOTAL_SALES_AMOUNT,
			tc.ROCKETDELI,
			tc.COUPANG_CODE
		FROM TB_PRODUCT tp
		LEFT JOIN TB_REVIEW tr
		ON tp.PRODUCT_CODE = tr.PRODUCT_CODE
		LEFT JOIN TB_COUPANG tc
		ON tp.PRODUCT_CODE = tc.PRODUCT_CODE
		WHERE KEYWORD_CODE = #{keywordCode}
		AND tp.PLATFORM = 'PLATFORM_02'
		GROUP BY tp.PRODUCT_CODE, tp.PRODUCT_NM, tp.SALES, tp.AMOUNT, tp.PLATFORM, tp.PRODUCT_IMG, tp.REGISTRATION_DT, tc.ROCKETDELI, tc.COUPANG_CODE
    </select>

    
    
